# Server Port
PORT=5000
NODE_ENV=development

# Database (Prisma SQLite for local zero-config, or PostgreSQL)
DATABASE_URL="file:./dev.db"

# Redis Connection (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Scheduler & Concurrency Settings
WORKER_CONCURRENCY=5
DEFAULT_DELAY_BETWEEN_EMAILS_SECONDS=2
DEFAULT_HOURLY_LIMIT=100

# Elasticsearch
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_INDEX=emails

# Fake SMTP (Ethereal Email - auto-created if empty)
ETHEREAL_USER=
ETHEREAL_PASS=

# Slack Integration for Rate Limit Alerts
SLACK_WEBHOOK_URL=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:5000/api/slack/callback

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

